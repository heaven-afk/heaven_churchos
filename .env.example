# Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, add values in Project Settings → Environment Variables and redeploy.
# Never commit .env.local to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Optional: leave BOTH empty to use the browser-only workspace without cloud auth.
# For Supabase auth/storage, set BOTH from your project's Settings → API.
# Use the public anon key, NEVER a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
# The current auth callback uses the request origin, so no app URL variable is
# required. Configure Site URL and Redirect URLs in the Supabase dashboard instead.
